  labs(title = "Mean Tweet Sentiment Over Time",
       x = "Date",
       y = "Mean Sentiment Score") +
  theme_minimal() +
  scale_y_continuous(labels = scales::number_format(accuracy = 0.01))  # Format y-axis for better readability






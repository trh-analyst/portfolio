#Task 2####

#open new instance of corpus
tweets <- read_excel("AppleiPadiPhone_Full_FreshInstance.xlsx", 
                     sheet = "Edges"
) %>%
  as_tibble()


#Clean data for visualization####

#remove URLS
tweets <- tweets %>%
  mutate(Tweet = gsub("http[s]?://\\S+|www\\.\\S+", "", Tweet))

#Make words lowercase and one token per line
tidy_tweet_words <- tweets %>%
  unnest_tokens(word, 
                Tweet,
                to_lower = TRUE)

#Remove stop words, getting sentiments from bing dictionary  
tidy_tweet_words <- tidy_tweet_words %>%
  anti_join(stop_words)

word_count <- tidy_tweet_words %>%
  count(Linenumber)

#determine postive and negative sentiment of each post

#Remove stop words, getting sentiments from bing dictionary, add in total lines  
tidy_tweet_sentiments <- tidy_tweet_words %>%
  inner_join(get_sentiments("afinn")) %>%
  inner_join(word_count) %>%
  rename (total_lines = n)

#Preview the results of the sentiments
tidy_tweet_sentiments

#structure dataset for visualization by date(not line number).
#separately if needed
tweets_score_sentiment <- tidy_tweet_sentiments %>%
  group_by(Date, total_lines) %>%
  summarise(Total_Sentiment = sum(value))

tweets_score_sentiment <- tweets_score_sentiment %>%
  mutate (Mean_Sentiment = Total_Sentiment/total_lines)

#Preview tweets_score_sentiment
tweets_score_sentiment

# Graphing with ggplot ####
#Step 5 Use ggplot2 to create a time series plot over the time of the dataset.###



#Plotting single values in a scatter plot
ggplot(tweets_score_sentiment, aes(Date, Mean_Sentiment)) + 
  geom_point()

#use geometrically smoothed trend line (w. uncertainty) to illustrate trend of pos and neg sentiment
#Add a smooting line, linear regression model
ggplot(tweets_score_sentiment, aes(Date, Mean_Sentiment)) + 
  geom_point() + 
  geom_smooth(method = "lm", formula = y ~ x, linewidth = 1)

#use a weighted aesthetic for pos and neg sentiments; 
#add a smoothing line with locally weighted regression (you have to specify the window)
ggplot(tweets_score_sentiment, aes(Date, Mean_Sentiment)) + 
  geom_point() + 
  geom_smooth(method = "loess",span = 5, linewidth = 1)

#Specify the confidence interval
ggplot(tweets_score_sentiment, aes(Date, Mean_Sentiment)) + 
  geom_point() + 
  geom_smooth(method = "loess",span = 5, level = .99, linewidth = 1)

#Put it on auto. But be mindful to of the model it uses
ggplot(tweets_score_sentiment, aes(Date, Mean_Sentiment)) + 
  geom_point() + 
  geom_smooth(method = "auto", linewidth = 1)

#Use hollow circles to clear out the visual
ggplot(tweets_score_sentiment, aes(Date, Mean_Sentiment)) + 
  geom_point(shape = 1) + 
  geom_smooth(method = "auto", linewidth = 1)

#Use smaller points to clear out visual
ggplot(tweets_score_sentiment, aes(Date, Mean_Sentiment)) + 
  geom_point(shape = ".") + 
  geom_smooth(method = "auto", linewidth = 1)

#Make the points more transparent
ggplot(tweets_score_sentiment, aes(Date, Mean_Sentiment)) + 
  geom_point(shape = 1, alpha = 1/3) + 
  geom_smooth(method = "auto", linewidth = 1)



-- MAGIC %md # Gold
-- MAGIC
-- MAGIC use the silver table to create the following tables in the gold database 
-- MAGIC   - dim_date (date_key, date), 
-- MAGIC   - dim_county (county_key, county, fips ,state), 
-- MAGIC   - fact_covid (date_key, county_key, cases, deaths, NewCases, NewDeaths, Rolling2WeekAvgNewCases, Rolling2WeekAvgNewDeaths)

-- COMMAND ----------

CREATE OR REPLACE TABLE gold.dim_date AS
SELECT
*
FROM silver.date



-- COMMAND ----------

CREATE OR REPLACE TABLE gold.dim_county
AS
SELECT
monotonically_increasing_id() as county_key,
*
FROM
silver.county

-- COMMAND ----------

CREATE OR REPLACE TABLE gold.fact_covid
AS
SELECT
monotonically_increasing_id() as covid_key,
co.cases,
co.deaths,
co.NewCases,
co.NewDeaths,
co.Rolling2WeekAvgCases,
co.Rolling2WeekAvgDeaths,
cty.county_key,
da.date_key
FROM silver.covid co
LEFT JOIN gold.dim_county cty ON co.fips = cty.fips
LEFT JOIN gold.dim_date da ON co.date = da.formatted_date


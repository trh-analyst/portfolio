CTY.ctyname as county,
(COV.Rolling2WeekAvgCases/CTY.popestimate2019) * 100000 as TwoWeekAvgCasesPer100k
FROM
gold.fact_covid COV
LEFT JOIN gold.dim_county CTY ON COV.county_key = CTY.county_key
LEFT JOIN gold.dim_date DAT ON COV.date_key = DAT.date_key

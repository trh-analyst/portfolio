-- DBTITLE 1,rolling 2 week average calculation over the cumulative cases
-- you will need to calculate this over the "daily new cases" field that you create

CREATE OR REPLACE TABLE silver.covid
AS
SELECT
  *,
  avg(NewCases) over (
    partition by fips
    order by
      date ASC
    rows between 13 PRECEDING and current row
  ) as Rolling2WeekAvgCases,
   avg(NewDeaths) over (
    partition by fips
    order by
      date ASC
    rows between 13 PRECEDING and current row
  ) as Rolling2WeekAvgDeaths
FROM
  temp2

-- COMMAND ----------


--date
CREATE OR REPLACE TABLE silver.date
AS
SELECT
*,
TO_DATE(full_date, 'M/d/yyy') formatted_date
FROM
bronze.date

-- COMMAND ----------

--county

CREATE OR REPLACE TABLE silver.county
AS
SELECT
concat(STATE, COUNTY) as FIPS,
*
FROM
bronze.county



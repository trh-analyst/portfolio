-- DBTITLE 1,Add additional calculations
CREATE OR REPLACE TEMP VIEW temp1
AS
SELECT
  *,
  --this is a window function. It splits the dataset up, orders and groups it by categories, and performs some function over the results
  --http://spark.apache.org/docs/latest/sql-ref-syntax-qry-select-window.html
  LAG(cases) OVER (PARTITION BY fips ORDER BY date ASC) AS PreviousDayCases,
  LAG(deaths) OVER (PARTITION BY fips ORDER BY date ASC) AS PreviousDayDeaths
FROM
  bronze.covid

-- COMMAND ----------

CREATE
OR REPLACE TEMP VIEW temp2 AS
SELECT
  *,
  cases - PreviousDayCases as NewCases,
  deaths - PreviousDayDeaths as NewDeaths
FROM
  temp1

